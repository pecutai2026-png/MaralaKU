{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maralaku",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": {"command": "node scripts/build-cloud.cjs"},
  "assets": {"directory": "./dist/public", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [
    {"name": "PLATFORM", "class_name": "MaralaPlatform"},
    {"name": "TENANTS", "class_name": "MaralaTenant"}
  ]},
  "migrations": [{"tag": "maralaku-v1", "new_sqlite_classes": ["MaralaPlatform", "MaralaTenant"]}],
  "observability": {"enabled": true}
}
